# ==============================================================================
# Universal Link Downloader Telegram Bot - Environment Configuration Template
# ==============================================================================

# --- Telegram MTProto Credentials ---
# Obtain BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Obtain API_ID and API_HASH from https://my.telegram.org (App Configuration)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Admin Telegram User IDs (Comma-separated list) ---
ADMIN_IDS=123456789,987654321

# --- Database Engines ---
# SQLite: sqlite:///data/bot.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/bot_db
# MongoDB: mongodb://localhost:27017/universal_bot_db (or mongodb+srv://user:pass@cluster.mongodb.net/universal_bot_db)
DATABASE_URL=sqlite:///data/bot.db

# --- Distributed Queue & Clustered Workers (Redis) ---
# Set REDIS_URL to enable distributed priority queues, pub/sub, locks, and multi-worker clusters
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# --- Prometheus Metrics & Telemetry ---
METRICS_ENABLED=false
METRICS_PORT=9090

# --- Storage Directories ---
DOWNLOAD_DIR=./downloads
TEMP_DIR=./temp
LOG_DIR=./logs

# --- Global Concurrency & Limits ---
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_UPLOADS=2
MAX_DOWNLOAD_SIZE=4GB
DOWNLOAD_TIMEOUT=3600
MAX_RETRIES=3

# --- User Limits ---
MAX_ACTIVE_JOBS_PER_USER=2
MAX_QUEUE_SIZE_PER_USER=5
MAX_DAILY_DOWNLOADS_PER_USER=20

# --- UI & Progress ---
PROGRESS_UPDATE_INTERVAL=3.0
AUTO_PROCESS=true

# --- Telegram Channels & Security Modes ---
# Activity audit log channel ID (e.g. -1001234567890 or @MyLogChannel)
LOG_CHANNEL_ID=
# Media backup / dump channel ID (e.g. -1009876543210 or @MyBackupChannel)
BACKUP_CHANNEL_ID=
# Restrict bot usage to whitelisted users & admins only
PRIVATE_MODE=false
# Require users to join a channel before downloading (e.g. @MyChannel or -100...)
FORCE_SUB_CHANNEL=

# --- Security & Logging ---
SSRF_PROTECTION_ENABLED=true
LOG_LEVEL=INFO

# --- Optional Service Credentials ---
# TeraBox NDUS cookie value (optional, for higher speed/private shares)
TERABOX_COOKIE=

# GoFile API Settings (Optional account token for elevated rate limits)
GOFILE_API_TOKEN=
GOFILE_API_TIMEOUT=30
GOFILE_CACHE_TTL=900
GOFILE_MAX_RETRIES=3

# 1fichier API Key (optional, for direct fast links)
ONEFICHIER_API_KEY=
