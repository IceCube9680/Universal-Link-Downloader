[Unit]
Description=Universal Link Downloader Telegram Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=icecube
Group=icecube
WorkingDirectory=/home/icecube/Universal-Link-Downloader
EnvironmentFile=/home/icecube/Universal-Link-Downloader/.env
ExecStart=/home/icecube/Universal-Link-Downloader/start.sh
Restart=always
RestartSec=5s

# Logging & Resource Limits
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

# Clean shutdown
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
